{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production deploy target — same shape as wrangler.staging.jsonc (see its comments for the
  // naming convention and why `main`/`assets.directory` point at build output rather than
  // workers/app.ts source). Keep the two files' bindings/vars structurally in sync; only the
  // values (name, database, URL, log level) should differ.
  "name": "shopify-react-router-starter",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/index.js",
  "assets": {
    "directory": "dist/client",
  },
  // Workers Logs: stores the Worker's console output (app/lib/logger writes one JSON object per
  // line in deployed builds). To ship logs to an OTel backend, create a destination in the
  // Cloudflare dashboard and list it under `logs.destinations` (Workers Paid; see
  // https://developers.cloudflare.com/workers/observability/exporting-opentelemetry-data/).
  "observability": {
    "logs": { "enabled": true },
    "traces": { "enabled": false },
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Create with `wrangler d1 create shopify-react-router-starter` and paste the returned
      // `database_id` below. A separate database from staging's — never share one across
      // environments.
      "database_name": "shopify-react-router-starter",
      "database_id": "2fce3cd3-af9b-4f50-838d-e8933ab4a5df",
      "migrations_dir": "./drizzle",
    },
  ],
  // SHOPIFY_API_SECRET (signs/verifies webhook HMACs and OAuth callbacks — a real secret) is
  // deliberately NOT a `vars` entry below: set it once with `wrangler secret put
  // SHOPIFY_API_SECRET --config wrangler.production.jsonc`. See wrangler.staging.jsonc's comment
  // for why SHOPIFY_API_KEY, by contrast, is safe as a plain var.
  "vars": {
    "SHOPIFY_API_KEY": "9fcf4c60ff0052c701f4dc59be3034e3",
    "SCOPES": "read_products",
    // Replace once production has a real Workers route/custom domain (see the commented `routes`
    // block below) — must match whatever URL Shopify's app config points at for production.
    "SHOPIFY_APP_URL": "https://shopify-react-router-starter.personal-93c.workers.dev",
    "NODE_ENV": "production",
    // Blank leaves PostHog off. Set both to turn it on. The project key is public
    // (the browser receives it). Staging does not carry these keys.
    "POSTHOG_API_HOST": "",
    "POSTHOG_PROJECT_API_KEY": "",
  },
  // No custom route/domain has been decided yet (shopify.app.toml's application_url is still the
  // "https://example.com" scaffold default) — production deploys to its *.workers.dev subdomain
  // by default. Once a real domain exists, uncomment and fill in (and drop SHOPIFY_APP_URL's
  // workers.dev placeholder above to match):
  // "routes": [{ "pattern": "example.com", "custom_domain": true }],
  // Deploy fails while this secret is unset. Set it with `wrangler secret put`.
  "secrets": {
    "required": ["SHOPIFY_API_SECRET", "FEATUREBASE_APP_ID", "FEATUREBASE_SECRET"],
  },
}
