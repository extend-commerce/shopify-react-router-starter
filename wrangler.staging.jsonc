{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Migrations only. Staging is not its own Worker: it is the `staging` Preview of the production
  // Worker, configured in wrangler.production.jsonc's `previews` block. `wrangler d1 migrations
  // apply` only reads top-level databases, so this file names the staging database for
  // `pnpm run db:migrate:staging:remote`. It must point at the same database as
  // wrangler.production.jsonc's `previews.d1_databases`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shopify-react-router-starter-staging",
      "database_id": "33c75a41-fdcd-4540-bd1f-f67ad51ab96a",
      "migrations_dir": "./drizzle",
    },
  ],
}
