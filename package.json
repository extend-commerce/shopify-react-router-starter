{
  "name": "shopify-react-router-starter",
  "private": true,
  "scripts": {
    "format:check": "prettier --check app/ --ignore-unknown --no-error-on-unmatched-pattern",
    "format": "prettier --write app/ --ignore-unknown --no-error-on-unmatched-pattern",
    "typecheck": "tsc -b",
    "build": "IS_REACT_ROUTER_BUILD=1 react-router build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "vite dev",
    "dev:staging": "pnpm run build && wrangler dev --config wrangler.staging.jsonc",
    "deploy:staging": "pnpm run build && wrangler deploy --config wrangler.staging.jsonc",
    "deploy:production": "pnpm run build && wrangler deploy --config wrangler.production.jsonc",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --local --config wrangler.staging.jsonc",
    "db:migrate:staging:remote": "wrangler d1 migrations apply DB --remote --config wrangler.staging.jsonc",
    "db:migrate:production": "wrangler d1 migrations apply DB --local --config wrangler.production.jsonc",
    "db:migrate:production:remote": "wrangler d1 migrations apply DB --remote --config wrangler.production.jsonc",
    "setup": "drizzle-kit generate",
    "lint": "oxlint",
    "shopify": "shopify",
    "drizzle": "drizzle-kit",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "commit": "cz",
    "prepare": "node .husky/install.mjs",
    "postinstall": "graphql-codegen"
  },
  "type": "module",
  "engines": {
    "node": "^20.10 || >=21.0.0"
  },
  "dependencies": {
    "@graphql-codegen/cli": "^7.4.2",
    "@logtape/logtape": "^2.3.7",
    "@logtape/pretty": "^2.3.7",
    "@react-router/dev": "^7.18.4",
    "@react-router/fs-routes": "^7.18.4",
    "@shopify/shopify-app-react-router": "^3.0.0",
    "@shopify/shopify-app-session-storage-drizzle": "^6.0.0",
    "drizzle-orm": "^0.45.3",
    "isbot": "^5.2.2",
    "posthog-js": "^1.434.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "tiny-invariant": "^1.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.3",
    "@cloudflare/workers-types": "^5.20260923.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/cz-commitlint": "^21.2.3",
    "@libsql/client": "^0.18.0",
    "@shopify/admin-api-client": "^2.0.0",
    "@shopify/api-codegen-preset": "^3.0.0",
    "@shopify/app-bridge-types": "^0.7.2",
    "@shopify/polaris-types": "^1.1.0",
    "@shopify/shopify-api": "^15.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "commitizen": "^4.3.2",
    "drizzle-kit": "^0.31.11",
    "graphql-config": "^5.1.7",
    "husky": "^9.1.7",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "wrangler": "^4.136.3"
  },
  "workspaces": {
    "packages": [
      "extensions/*"
    ]
  },
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "resolutions": {
    "@graphql-tools/url-loader": "8.0.16",
    "minimatch": "9.0.5",
    "vite": "^6.4.3"
  },
  "overrides": {
    "@graphql-tools/url-loader": "8.0.16",
    "minimatch": "9.0.5",
    "vite": "^6.4.3"
  },
  "author": "hasham.khalid@extendcommerce.com",
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
