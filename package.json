{
  "name": "shopify-react-router-starter",
  "private": true,
  "scripts": {
    "format:check": "oxfmt --check --no-error-on-unmatched-pattern",
    "format": "oxfmt --no-error-on-unmatched-pattern",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "react-router build",
    "dev": "node scripts/assert-no-dev-vars.js && shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "deploy:staging": "pnpm run build && wrangler deploy --config wrangler.staging.jsonc",
    "deploy:production": "pnpm run build && wrangler deploy --config wrangler.production.jsonc",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging:remote": "wrangler d1 migrations apply DB --remote --config wrangler.staging.jsonc",
    "db:migrate:production:remote": "wrangler d1 migrations apply DB --remote --config wrangler.production.jsonc",
    "lint": "oxlint",
    "commit": "cz",
    "prepare": "node .husky/install.mjs",
    "postinstall": "graphql-codegen",
    "router-typegen": "react-router typegen"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@graphql-codegen/cli": "^7.4.2",
    "@logtape/logtape": "^2.3.7",
    "@logtape/pretty": "^2.3.7",
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@shopify/shopify-app-react-router": "^3.0.0",
    "@shopify/shopify-app-session-storage-drizzle": "^6.0.0",
    "drizzle-orm": "^0.45.3",
    "isbot": "^5.2.2",
    "posthog-js": "^1.434.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "7.18.2",
    "tiny-invariant": "^1.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.0",
    "@cloudflare/workers-types": "^5.20260928.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/cz-commitlint": "^21.2.3",
    "@libsql/client": "^0.18.0",
    "@shopify/admin-api-client": "^2.0.0",
    "@shopify/api-codegen-preset": "^3.0.0",
    "@shopify/app-bridge-types": "^0.7.2",
    "@shopify/cli": "4.9.3",
    "@shopify/polaris-types": "^1.1.0",
    "@shopify/shopify-api": "^15.0.0",
    "@total-typescript/shoehorn": "^0.1.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "commitizen": "^4.3.2",
    "drizzle-kit": "^0.31.11",
    "graphql-config": "^5.1.7",
    "husky": "^9.1.7",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.143.0"
  },
  "workspaces": {
    "packages": [
      "extensions/*"
    ]
  },
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "resolutions": {
    "@graphql-tools/url-loader": "8.0.16",
    "minimatch": "9.0.5"
  },
  "overrides": {
    "@graphql-tools/url-loader": "8.0.16",
    "minimatch": "9.0.5"
  },
  "author": "hasham.khalid@extendcommerce.com",
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
