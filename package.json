{
  "name": "shopify-react-router-starter",
  "private": true,
  "scripts": {
    "format:check": "oxfmt --check --no-error-on-unmatched-pattern",
    "format": "oxfmt --no-error-on-unmatched-pattern",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "react-router build",
    "dev": "node scripts/assert-no-dev-vars.js && shopify app dev --config development",
    "explorer": "node scripts/open-local-explorer.js",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "deploy:staging": "pnpm run build && wrangler deploy --config wrangler.staging.jsonc",
    "deploy:production": "pnpm run build && wrangler deploy --config wrangler.production.jsonc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging:remote": "wrangler d1 migrations apply DB --remote --config wrangler.staging.jsonc",
    "db:migrate:production:remote": "wrangler d1 migrations apply DB --remote --config wrangler.production.jsonc",
    "lint": "oxlint",
    "commit": "cz",
    "prepare": "node .husky/install.mjs",
    "postinstall": "graphql-codegen && react-router typegen && wrangler types",
    "router-typegen": "react-router typegen"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@logtape/logtape": "^2.4.2",
    "@logtape/pretty": "^2.4.2",
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@shopify/shopify-app-react-router": "^3.0.2",
    "@shopify/shopify-app-session-storage-drizzle": "^6.0.1",
    "drizzle-orm": "^0.45.4",
    "featurebase-js": "^1.0.3",
    "isbot": "^5.2.2",
    "jsonwebtoken": "^9.0.3",
    "posthog-js": "^1.438.22",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "7.18.2",
    "tiny-invariant": "^1.3.3",
    "wrangler": "^4.152.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/cz-commitlint": "^21.2.4",
    "@shopify/admin-api-client": "^2.0.1",
    "@shopify/api-codegen-preset": "^3.0.0",
    "@shopify/app-bridge-types": "^0.7.3",
    "@shopify/cli": "4.9.3",
    "@shopify/polaris-types": "^1.1.0",
    "@shopify/shopify-api": "^15.0.1",
    "@total-typescript/shoehorn": "^0.1.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "commitizen": "^4.3.2",
    "drizzle-kit": "^0.31.11",
    "graphql-config": "^5.1.8",
    "husky": "^9.1.7",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "workspaces": {
    "packages": [
      "extensions/*"
    ]
  },
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "resolutions": {
    "@graphql-tools/url-loader": "8.0.16",
    "minimatch": "9.0.5"
  },
  "overrides": {
    "@graphql-tools/url-loader": "8.0.16",
    "minimatch": "9.0.5"
  },
  "author": "hasham.khalid@extendcommerce.com",
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
