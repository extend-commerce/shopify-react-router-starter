{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Local dev only (`pnpm dev`). Staging and production have their own wrangler files and
  // are never started from this one. The D1 id is a placeholder: miniflare never talks to
  // a remote database.
  "name": "shopify-react-router-starter",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "workers/app.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shopify-react-router-starter-placeholder",
      "database_id": "00000000-0000-0000-0000-000000000000",
      // Points at drizzle-kit's own output dir (see drizzle.config.ts) so
      // `wrangler d1 migrations apply DB --local` picks up the same migrations `drizzle-kit
      // generate` produces, instead of wrangler's unrelated default `./migrations` folder.
      "migrations_dir": "./drizzle",
    },
  ],
  // Allowlist of shell env copied into the Worker. The Shopify CLI injects the first
  // three; vite.config.ts maps HOST or APP_URL onto SHOPIFY_APP_URL. Anything else in
  // the shell stays out.
  "secrets": {
    "required": [
      "SHOPIFY_API_KEY",
      "SHOPIFY_API_SECRET",
      "SCOPES",
      "SHOPIFY_APP_URL",
      "FEATUREBASE_APP_ID",
      "FEATUREBASE_SECRET",
    ],
  },
}
