{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "quoteProps": "consistent",
  "arrowParens": "avoid",
  "printWidth": 100,
  "sortPackageJson": false,
  "ignorePatterns": [
    "package.json",
    ".shadowenv.d",
    ".vscode",
    "node_modules",
    "public",
    ".shopify",
    "pnpm-lock.yaml",
    "*.graphql",
    "*.json",
    "*.jsonc",
    "*.yaml",
    "*.yml",
    "*.toml",
    "*.md"
  ]
}
